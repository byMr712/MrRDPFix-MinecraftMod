{
  "schemaVersion": 1,
  "id": "rdpmouse",
  "version": "${version}",
  "name": "[MR] RDP Mouse",
  "description": "Fixes mouse look when playing over RDP (Remote Desktop Protocol), and allows camera rotation with the keyboard.",
  "license": "MIT",
  "environment": "client",
  "authors": [
    "KesslerCascade",
    "byMr712"
  ],
  "contact": {
    "homepage": "https://github.com/byMr712/MrRDPFix-MinecraftMod",
    "sources": "https://github.com/byMr712/MrRDPFix-MinecraftMod"
  },
  "entrypoints": {
    "client": [
      "kesslercascade.rdpmouse.RDPMouseClient"
    ],
    "modmenu": [
      "kesslercascade.rdpmouse.config.RDPMouseModMenu"
    ]
  },
  "mixins": [
    "rdpmouse.mixins.json"
  ],
  "accessWidener": "rdpmouse.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
